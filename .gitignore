# ==========================================
# Результаты сборки (Build outputs)
# ==========================================
[Bb]in/
[Oo]bj/
[L3]og/
[L3]ogs/

# ==========================================
# Файлы пользовательских настроек (User-specific)
# ==========================================
*.user
*.userosv
*.suo
*.userprefs

# ==========================================
# Папки и настройки IDE (Visual Studio / VS Code)
# ==========================================
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ==========================================
# Системные файлы операционной системы
# ==========================================
Thumbs.db
[Dd]esktop.ini
.DS_Store

# ==========================================
# Резервные копии и временные файлы
# ==========================================
*.tmp
*.bak
*.sav
